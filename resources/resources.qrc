<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <!-- 字体文件是可选的，如果没有字体文件，程序会使用系统字体 -->
        <file>fonts/CascadiaCode.ttf</file>
        <file>fonts/JetBrainsMono-Regular.ttf</file>

        <!-- 应用样式表模板（ThemeManager 运行时渲染占位符） -->
        <file>styles/app.qss</file>

        <!-- 应用图标（窗口/任务栏；可执行文件图标由 .pro 的 RC_ICONS 嵌入） -->
        <file>icons/app.png</file>

        <!-- QSS 引用的图标资源（其余图标内嵌于 IconProvider） -->
        <file>icons/chevron-down.svg</file>
        <file>icons/chevron-up.svg</file>
        <file>icons/close.svg</file>
        <file>icons/check.svg</file>
        <file>icons/check-dark.svg</file>

        <!-- 如需添加更多字体，请下载后取消下面行的注释 -->
        <!-- <file>fonts/FiraCode-Regular.ttf</file> -->
        <!-- <file>fonts/SourceCodePro-Regular.ttf</file> -->
    </qresource>
</RCC>
