# =============================================================================
# libssh 编译相关忽略规则
# =============================================================================

# libssh 源码目录（自动下载，不需要提交）
/libssh-src/

# libssh 编译临时文件
/libssh-build/

# libssh 编译输出目录（编译产物）
/libssh/

# 依赖库源码和编译产物（zlib、OpenSSL 等）
/deps/

# 编译输出的 bin 目录（DLL 文件会自动复制）
/bin/

# 预编译依赖库（OpenSSL/zlib），可自动下载
# 如果已有本地副本，取消下面的注释以保留
/openssl-deps/

# 便携版工具
/7zr.exe